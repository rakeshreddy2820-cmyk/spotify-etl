# Secrets (API keys, passwords) - never commit
.env

# Airflow writes its task logs here
logs/

# Data the pipeline produces: ignore everything inside data/...
data/*
# ...except .gitkeep, so the empty folder still exists on GitHub
!data/.gitkeep

# Python virtual environment
.venv/

# Python cache files, created automatically when code runs
__pycache__/
*.pyc